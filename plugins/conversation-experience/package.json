{
  "name": "@hanger-source/dsh-conversation-experience",
  "version": "0.2.0",
  "description": "DSH 长思考内容滚动体验",
  "license": "MIT",
  "scripts": {
    "build": "node build-client.mjs",
    "check": "node build-client.mjs --check"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
